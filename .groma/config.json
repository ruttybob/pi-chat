{
  "scanners": [
    {
      "id": "typescript",
      "source": "@groma/scanner-typescript@0.2.4",
      "include": [
        "**/*.ts",
        "**/*.tsx",
        "**/tsconfig*.json",
        "**/package.json",
        "**/*.html",
        "**/angular.json",
        "**/project.json",
        "**/nx.json"
      ],
      "exclude": [
        "*.test.ts",
        "*.test.tsx",
        "*.spec.ts",
        "*.spec.tsx",
        "/test/",
        "node_modules/",
        "dist/",
        "build/",
        "coverage/"
      ]
    }
  ],
  "workSources": []
}
